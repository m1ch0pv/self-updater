{
    "name": "m1ch0pv/self-update-app",
    "description": "A PHAR that securely updates itself (RSA-signed, SHA-256 checked).",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "ext-phar": "*",
        "symfony/yaml": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    }
}
